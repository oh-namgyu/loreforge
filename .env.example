# Copy to .env (or export these) and adjust. Values shown are the defaults.

# Required. Used for bible generation via the Anthropic Messages API.
ANTHROPIC_API_KEY=

# Optional. Without it the app runs text-only and board rendering returns 409.
OPENAI_API_KEY=

# Required for any non-loopback bind: the app refuses to start on HOST=0.0.0.0
# without it. Optional (and off) when bound to 127.0.0.1.
AUTH_TOKEN=

# Bind address. Leave on loopback unless you front the app with a TLS proxy.
HOST=127.0.0.1

# HTTP port.
PORT=6180

# Text model used for bible generation.
LOREFORGE_MODEL=claude-sonnet-5

# Image model used for board and solo renders.
LOREFORGE_IMAGE_MODEL=gpt-image-1

# Directory holding data/books/<slug>/ and the deleted-book trash.
LOREFORGE_DATA=./data
